/* 1. File Input and Output */
void demo_file_io(void)
{
    char message[BUFFER_SIZE];
    char buffer[BUFFER_SIZE] = {0};

    printf("\n========== FILE I/O ==========\n");

    printf("Enter the text you want to write: ");

    if (fgets(message, sizeof(message), stdin) == NULL) {
        printf("Input error.\n");
        return;
    }

    int fd = open(DEMO_FILE, O_CREAT | O_WRONLY | O_TRUNC, 064>

    if (fd == -1) {
        print_error("open");
        return;
    }

    size_t length = strlen(message);
    size_t total_written = 0;

    while (total_written < length) {
        ssize_t written = write(fd, message + total_written,
                                length - total_written);

        if (written == -1) {
            print_error("write");
            close(fd);
            return;
        }

        total_written += (size_t)written;
    }
 printf("\n[File I/O] Text written successfully using write>
    printf("[File I/O] Bytes written: %zu\n", total_written);

    if (close(fd) == -1) {
        print_error("close");
        return;
    }

    fd = open(DEMO_FILE, O_RDONLY);

    if (fd == -1) {
        print_error("open for reading");
        return;
    }

    ssize_t bytes_read = read(fd, buffer, sizeof(buffer) - 1);

    if (bytes_read == -1) {
        print_error("read");
        close(fd);
        return;
    }

    buffer[bytes_read] = '\0';

    printf("[File I/O] Reading saved text:\n");
    printf("%s", buffer);

    close(fd);

    printf("[File I/O] File closed successfully.\n");
}

/* 2. Process Management */
void demo_process_management(void)
{
    printf("\n========== PROCESS MANAGEMENT ==========\n");

    pid_t pid = fork();

    if (pid < 0) {
        print_error("fork");
        return;
    }

    if (pid == 0) {
        printf("[Process] Child process created.\n");
        printf("[Process] Child PID: %d\n", getpid());
        printf("[Process] Parent PID: %d\n", getppid());

        printf("[Process] Executing ls command using exec().\n>

        execlp("ls", "ls", "-l", DEMO_FILE, (char *)NULL);

        print_error("execlp");
        _exit(EXIT_FAILURE);
    } else {
        int status;

        printf("[Process] Parent process PID: %d\n", getpid());
        printf("[Process] Waiting for child process.\n");

        if (waitpid(pid, &status, 0) == -1) {
            print_error("waitpid");
            return;
 }

        printf("[Process] Child process completed.\n");
    }
}

