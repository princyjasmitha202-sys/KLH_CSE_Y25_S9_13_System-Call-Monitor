/* 4. Signal Handling */
void signal_handler(int signum)
{
    if (signum == SIGUSR1) {
  signal_received = 1;
    }
}

void demo_signals(void)
{
    struct sigaction sa;

    printf("\n========== SIGNAL HANDLING ==========\n");

    memset(&sa, 0, sizeof(sa));
    sa.sa_handler = signal_handler;
    sigemptyset(&sa.sa_mask);

    if (sigaction(SIGUSR1, &sa, NULL) == -1) {
        print_error("sigaction");
        return;
    }

    printf("[Signal] Sending SIGUSR1 signal.\n");

    if (raise(SIGUSR1) != 0) {
        print_error("raise");
        return;
    }

    if (signal_received) {
        printf("[Signal] SIGUSR1 received and handled successf>
    }
}
/* 5. Memory Management */
void demo_memory_management(void)
{
    size_t size = 4096;

    printf("\n========== MEMORY MANAGEMENT ==========\n");

    char *memory = mmap(NULL, size,
                        PROT_READ | PROT_WRITE,
                        MAP_PRIVATE | MAP_ANONYMOUS,
                        -1, 0);

    if (memory == MAP_FAILED) {
        print_error("mmap");
        return;
    }

    snprintf(memory, size,
             "Memory allocated using mmap() system call.");

    printf("[Memory] Memory allocated successfully.\n");
    printf("[Memory] Stored data: %s\n", memory);

    if (munmap(memory, size) == -1) {
        print_error("munmap");
        return;
    }

    printf("[Memory] Memory released using munmap().\n");
}

/* 6. File System Information */
void demo_filesystem(void)
{
    struct stat file_info;

    printf("\n========== FILE SYSTEM INFORMATION ==========\n">

    if (access(DEMO_FILE, F_OK) == 0) {
        printf("[File System] File exists: %s\n", DEMO_FILE);
    } else {
        print_error("access");
        return;
    }

    if (stat(DEMO_FILE, &file_info) == -1) {
        print_error("stat");
        return;
    }

    printf("[File System] File size: %ld bytes\n",
           (long)file_info.st_size);

    printf("[File System] Inode number: %ld\n",
           (long)file_info.st_ino);

    printf("[File System] File permissions: %o\n",
           (unsigned int)(file_info.st_mode & 0777));

    printf("[File System] Owner user ID: %ld\n",
           (long)file_info.st_uid);
}
/* 7. Thread Synchronization */
void *thread_function(void *arg)
{
    int i;

    (void)arg;

    for (i = 0; i < 10000; i++) {
        pthread_mutex_lock(&counter_mutex);
        shared_counter++;
        pthread_mutex_unlock(&counter_mutex);
    }

    return NULL;
}

void demo_concurrency(void)
{
    pthread_t thread1, thread2;

    printf("\n========== THREAD CONCURRENCY ==========\n");

    shared_counter = 0;

    if (pthread_create(&thread1, NULL, thread_function, NULL) >
        fprintf(stderr, "Thread 1 creation failed.\n");
        return;
    }

    if (pthread_create(&thread2, NULL, thread_function, NULL) >
        fprintf(stderr, "Thread 2 creation failed.\n");
        pthread_join(thread1, NULL);
 return;
    }

    pthread_join(thread1, NULL);
    pthread_join(thread2, NULL);

    printf("[Thread] Two threads executed successfully.\n");
    printf("[Thread] Final shared counter: %d\n", shared_count>
    printf("[Thread] Mutex synchronization completed.\n");
}

